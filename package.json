{
  "name": "racing-game-station",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev-c": "rm -rf .next && yarn dev 2>&1 &",
    "build": "next build --turbopack",
    "start": "next start",
    "test": "node --experimental-strip-types --import ./scripts/test/register.mjs --test \"scripts/test/*.test.ts\"",
    "test:db": "npm test",
    "test:api": "npx tsx scripts/test-api.ts",
    "supabase-start": "supabase start",
    "supabase-stop": "supabase stop",
    "supabase-reset": "supabase reset",
    "supabase-migrate": "supabase db reset",
    "supabase-generate": "supabase gen types typescript --local --schema public > src/domain/types/supabase.ts",
    "supabase-db-diff": "supabase db diff --schema public",
    "type-check": "tsc --noEmit",
    "lint": "eslint",
    "deploy:vercel": "./scripts/deploy-vercel.sh production",
    "deploy:vercel:preview": "./scripts/deploy-vercel.sh preview",
    "deploy:supabase": "./scripts/deploy-supabase.sh push",
    "deploy:supabase:status": "./scripts/deploy-supabase.sh status",
    "deploy:all": "./scripts/deploy-all.sh",
    "setup:env": "./scripts/setup-env.sh",
    "setup:env:prod": "./scripts/setup-env.sh production",
    "setup:git-hooks": "./scripts/setup-git-hooks.sh",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "deploy:vinext": "vinext-cloudflare deploy",
    "deploy:cloudflare": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@react-spring/web": "^10.0.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.89.0",
    "@types/prismjs": "^1.26.5",
    "@uidotdev/usehooks": "^2.4.1",
    "axios": "^1.13.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "html2canvas": "^1.4.1",
    "localforage": "^1.10.0",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "prismjs": "^1.30.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.69.0",
    "react-spring": "^10.0.3",
    "react-to-print": "^3.2.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.8",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "^1.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.23",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "react-server-dom-webpack": "^19.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^1.4.0",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
